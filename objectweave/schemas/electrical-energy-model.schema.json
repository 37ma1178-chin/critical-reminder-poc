    "loads":{"type":"array","items":{"type":"object","required":["id","powerW","hoursPerDay","dutyCycle","quantity","truthClass"],"properties":{"id":{"type":"string"},"powerW":{"type":["number","null"]},"hoursPerDay":{"type":["number","null"],"minimum":0,"maximum":24},"dutyCycle":{"type":["number","null"],"minimum":0,"maximum":1},"quantity":{"type":"integer","minimum":1},"surgePowerW":{"type":["number","null"]},"acDc":{"enum":["AC","DC","UNKNOWN"]},"truthClass":{"enum":["AUTHORITATIVE_FACT","VERIFIED_MEASUREMENT","DERIVED","COMMUNITY_MEASURED","ESTIMATED","UNKNOWN"]}}}},
    "storage":{"type":"object","properties":{"nominalVoltageV":{"type":["number","null"]},"nominalCapacityAh":{"type":["number","null"]},"nominalCapacityWh":{"type":["number","null"]},"usableFraction":{"type":["number","null"],"minimum":0,"maximum":1},"maxContinuousDischargeW":{"type":["number","null"]},"maxDischargeA":{"type":["number","null"]}}},
    "sources":{"type":"object","properties":{"solar":{"type":"object","properties":{"arrayRatedW":{"type":["number","null"]},"peakSunHours":{"type":["number","null"]},"systemEfficiency":{"type":["number","null"],"minimum":0,"maximum":1}}},"alternator":{"type":"object","properties":{"chargePowerW":{"type":["number","null"]},"hoursPerDay":{"type":["number","null"]}}},"shore":{"type":"object","properties":{"chargePowerW":{"type":["number","null"]}}}}},
    "conversion":{"type":"object","properties":{"inverterContinuousW":{"type":["number","null"]},"inverterSurgeW":{"type":["number","null"]},"inverterEfficiency":{"type":["number","null"],"minimum":0,"maximum":1},"chargerEfficiency":{"type":["number","null"],"minimum":0,"maximum":1}}},
    "results":{"type":"object","properties":{"dailyLoadWh":{"type":["number","null"]},"peakContinuousLoadW":{"type":["number","null"]},"peakSurgeLoadW":{"type":["number","null"]},"requiredUsableStorageWh":{"type":["number","null"]},"requiredNominalStorageWh":{"type":["number","null"]},"estimatedSolarWhPerDay":{"type":["number","null"]},"estimatedAlternatorWhPerDay":{"type":["number","null"]},"dailyEnergyBalanceWh":{"type":["number","null"]}}},
