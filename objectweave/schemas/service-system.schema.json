{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ObjectWeave Service System",
  "type":"object",
  "required":["schemaVersion","id","systemType","nodes","routes","validation"],
  "properties":{
    "schemaVersion":{"const":"0.2.0"},
    "id":{"type":"string"},
    "systemType":{"enum":["ELECTRICAL","WATER","HVAC"]},
    "nodes":{"type":"array","items":{"$ref":"#/$defs/node"}},
    "routes":{"type":"array","items":{"$ref":"#/$defs/route"}},
    "zones":{"type":"array","items":{"$ref":"#/$defs/zone"}},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "node":{"type":"object","required":["id","kind","location","physicalEnvelope","serviceEnvelope","visibility"],"properties":{
      "id":{"type":"string"},"kind":{"type":"string"},"location":{"type":"object","required":["xMm","yMm","zMm"],"properties":{"xMm":{"type":"number"},"yMm":{"type":"number"},"zMm":{"type":"number"}}},
      "physicalEnvelope":{"$ref":"#/$defs/envelope"},"operatingEnvelope":{"$ref":"#/$defs/envelope"},"serviceEnvelope":{"$ref":"#/$defs/envelope"},
      "visibility":{"enum":["VISIBLE","CONCEALED_WITH_ACCESS","CONCEALED_NO_ACCESS"]},
      "accessZoneId":{"type":["string","null"]},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
    }},
    "route":{"type":"object","required":["id","systemType","fromNodeId","toNodeId","pathSegments","reservedEnvelope","status"],"properties":{
      "id":{"type":"string"},"systemType":{"enum":["ELECTRICAL","WATER","HVAC"]},"fromNodeId":{"type":"string"},"toNodeId":{"type":"string"},
      "pathSegments":{"type":"array","items":{"type":"object","required":["startMm","endMm"],"properties":{
        "startMm":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
        "endMm":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
        "bendRadiusMm":{"type":["number","null"]},"penetrationId":{"type":["string","null"]}
      }}},
      "reservedEnvelope":{"$ref":"#/$defs/envelope"},"minimumClearanceMm":{"type":["number","null"]},
      "serviceAccessZoneId":{"type":["string","null"]},"status":{"enum":["PASS","CONDITIONAL","WARNING","FAIL","VERIFICATION_REQUIRED","NOT_RUN"]},
      "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
    }},
    "zone":{"type":"object","required":["id","kind","envelope","accessRequired"],"properties":{
      "id":{"type":"string"},"kind":{"type":"string"},"envelope":{"$ref":"#/$defs/envelope"},"accessRequired":{"type":"boolean"}
    }},
    "envelope":{"type":"object","required":["xMm","yMm","zMm"],"properties":{
      "xMm":{"type":"number","minimum":0},"yMm":{"type":"number","minimum":0},"zMm":{"type":"number","minimum":0}
    }},
    "evidence":{"type":"object","required":["truthClass","confidence"],"properties":{
      "truthClass":{"enum":["AUTHORITATIVE_FACT","VERIFIED_MEASUREMENT","DERIVED","COMMUNITY_MEASURED","ESTIMATED","UNKNOWN"]},
      "confidence":{"enum":["HIGH","MEDIUM","LOW","UNKNOWN"]},"sourceUri":{"type":["string","null"]},"notes":{"type":["string","null"]}
    }},
    "validation":{"type":"object","required":["status","findings"],"properties":{
      "status":{"enum":["PASS","CONDITIONAL","WARNING","FAIL","VERIFICATION_REQUIRED","NOT_RUN"]},
      "findings":{"type":"array","items":{"type":"object","required":["code","severity","status"],"properties":{
        "code":{"type":"string"},"severity":{"enum":["INFO","WARNING","ERROR","BLOCKER"]},"status":{"enum":["PASS","CONDITIONAL","WARNING","FAIL","VERIFICATION_REQUIRED","NOT_RUN"]},"message":{"type":"string"}
      }}}
    }}
  }
}